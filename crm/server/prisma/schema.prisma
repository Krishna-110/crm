// MediCRM — schema. Prisma owns this outright; `prisma migrate` generates all DDL.
//
// Deliberately absent, and why:
//   * No triggers, functions or stored procedures. All behaviour lives in src/services.
//   * No RLS. Authorization is src/auth/scope.ts, applied by the client extension.
//   * No table partitioning. The previous schema partitioned three history tables by month,
//     which cost 208 child tables and a scheduler job to keep ahead of. Retention is a
//     delete, not a partition drop.
//   * No tsvector/GIN full-text columns. Search uses indexed case-insensitive matching.
//   * No citext. Email is lowercased on write and carries a plain unique index.
//   * No GENERATED columns. lineTotal and payableAmount are computed in TypeScript, where
//     the pricing rules are readable and testable.
//
// Convention: models and fields are camelCase; tables and columns are snake_case via @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── enums ────────────────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  caller
}

enum UserStatus {
  active
  inactive
}

enum LeadActivityType {
  call
  comment
  status_change
  follow_up
  assignment
  created
}

enum NotificationType {
  info
  warning
  success
  error
}

enum NotificationEntityType {
  lead
  order
  renewal
  follow_up
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

enum DiscountType {
  none
  flat
  percentage
}

// ── lookup tables ────────────────────────────────────────────────────────────────────────
// Kept as tables rather than enums: /api/lookups serves them to the frontend, and migration
// 002 of the previous schema made them admin-editable on purpose.

model LeadStatus {
  code      String   @id
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  leads     Lead[]

  @@map("lead_statuses")
}

model LeadSource {
  code      String   @id
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  leads     Lead[]

  @@map("lead_sources")
}

model OrderStage {
  code      String   @id
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orders    Order[]

  @@map("order_stages")
}

model PaymentStatus {
  code      String   @id
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orders    Order[]

  @@map("payment_statuses")
}

model FollowUpType {
  code      String     @id
  label     String
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  followUps FollowUp[]

  @@map("follow_up_types")
}

model FollowUpStatus {
  code      String     @id
  label     String
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  followUps FollowUp[]

  @@map("follow_up_statuses")
}

// ── people ───────────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  employeeId   String     @unique @map("employee_id")
  name         String
  phone        String
  /// Lowercased on write by the user service; the unique index then gives
  /// case-insensitive uniqueness without needing the citext extension.
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(caller)
  status       UserStatus @default(active)
  /// Denormalised count of live assigned leads, recomputed by the lead service.
  assignedLeadsCount Int  @default(0) @map("assigned_leads_count")
  lastLoginAt  DateTime?  @map("last_login_at")
  avatarUrl    String?    @map("avatar_url")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  sessions          Session[]
  assignedLeads     Lead[]             @relation("LeadAssignedCaller")
  assignedRenewals  Renewal[]          @relation("RenewalAssignedCaller")
  assignedFollowUps FollowUp[]         @relation("FollowUpAssignedCaller")
  notifications     Notification[]
  leadAssignments   LeadAssignment[]   @relation("AssignmentCaller")

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  issuedAt  DateTime @default(now()) @map("issued_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  fullName        String    @map("full_name")
  primaryMobile   String    @map("primary_mobile")
  alternateMobile String?   @map("alternate_mobile")
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  doctorName      String?   @map("doctor_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  leads     Lead[]
  orders    Order[]
  renewals  Renewal[]
  followUps FollowUp[]

  @@index([primaryMobile])
  @@index([fullName])
  @@map("customers")
}

// ── catalogue ────────────────────────────────────────────────────────────────────────────

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  sku           String    @unique
  genericName   String    @map("generic_name")
  brandName     String?   @map("brand_name")
  strength      String?
  dosageForm    String?   @map("dosage_form")
  unitPrice     Decimal   @default(0) @map("unit_price") @db.Decimal(12, 2)
  stockQuantity Int       @default(0) @map("stock_quantity")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  leadMedicines LeadMedicine[]
  orderItems    OrderItem[]
  renewals      Renewal[]

  @@index([brandName])
  @@index([genericName])
  @@index([isActive, deletedAt])
  @@map("products")
}

// ── pipeline ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id               String    @id @default(uuid()) @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  /// Snapshot of the customer's name at the time of capture, kept in step by the lead
  /// service. A lead may exist before any customer record does.
  customerName     String    @map("customer_name")
  mobile           String
  alternateNumber  String?   @map("alternate_number")
  address          String
  city             String
  state            String
  pincode          String
  /// Denormalised summary of the requested medicines, for list display and search.
  medicineRequired String?   @map("medicine_required")
  quantity         Int       @default(1)
  doctorName       String?   @map("doctor_name")
  disease          String
  paymentScreenshot String?  @map("payment_screenshot")
  assignedCallerId String?   @map("assigned_caller_id") @db.Uuid
  leadSource       String    @default("other") @map("lead_source")
  status           String    @default("new")
  lastFollowUpAt   DateTime? @map("last_follow_up_at")
  nextFollowUpAt   DateTime? @map("next_follow_up_at")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by") @db.Uuid

  customer       Customer?        @relation(fields: [customerId], references: [id])
  assignedCaller User?            @relation("LeadAssignedCaller", fields: [assignedCallerId], references: [id])
  leadStatus     LeadStatus       @relation(fields: [status], references: [code])
  source         LeadSource       @relation(fields: [leadSource], references: [code])
  medicines      LeadMedicine[]
  activities     LeadActivity[]
  assignments    LeadAssignment[]
  orders         Order[]
  followUps      FollowUp[]

  @@index([assignedCallerId, deletedAt])
  @@index([status])
  @@index([customerId])
  @@index([mobile])
  @@index([createdAt])
  @@map("leads")
}

model LeadMedicine {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  medicineName String   @map("medicine_name")
  days         Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([leadId])
  @@map("lead_medicines")
}

/// History table. Previously partitioned by month; now a plain table — retention is a
/// delete, and at this volume the partitioning cost more than it saved.
model LeadActivity {
  id           String           @id @default(uuid()) @db.Uuid
  leadId       String           @map("lead_id") @db.Uuid
  activityType LeadActivityType @map("activity_type")
  description  String
  createdBy    String?          @map("created_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

/// Assignment history, maintained by the lead service on every reassignment.
model LeadAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  leadId       String    @map("lead_id") @db.Uuid
  callerId     String    @map("caller_id") @db.Uuid
  assignedBy   String?   @map("assigned_by") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  reason       String?

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  caller User @relation("AssignmentCaller", fields: [callerId], references: [id])

  @@index([leadId])
  @@index([callerId, unassignedAt])
  @@map("lead_assignments")
}

// ── orders ───────────────────────────────────────────────────────────────────────────────

model Order {
  id              String       @id @default(uuid()) @db.Uuid
  orderNumber     String       @unique @map("order_number")
  customerId      String       @map("customer_id") @db.Uuid
  leadId          String?      @map("lead_id") @db.Uuid
  customerName    String       @map("customer_name")
  shippingAddress String       @map("shipping_address")
  /// Sum of live line totals, recomputed by the order service.
  totalAmount     Decimal      @default(0) @map("total_amount") @db.Decimal(14, 2)
  discountType    DiscountType @default(none) @map("discount_type")
  discountValue   Decimal      @default(0) @map("discount_value") @db.Decimal(14, 2)
  /// total minus discount, floored at zero. Was a GENERATED column; now computed by the
  /// order service alongside totalAmount so the pricing rule lives in one readable place.
  payableAmount   Decimal      @default(0) @map("payable_amount") @db.Decimal(14, 2)
  paymentStatus   String       @default("pending") @map("payment_status")
  stage           String       @default("confirmed")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  createdBy       String?      @map("created_by") @db.Uuid

  customer      Customer      @relation(fields: [customerId], references: [id])
  lead          Lead?         @relation(fields: [leadId], references: [id])
  orderStage    OrderStage    @relation(fields: [stage], references: [code])
  payment       PaymentStatus @relation(fields: [paymentStatus], references: [code])
  items         OrderItem[]
  renewals      Renewal[]

  @@index([customerId])
  @@index([leadId])
  @@index([stage])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                   String    @id @default(uuid()) @db.Uuid
  orderId              String    @map("order_id") @db.Uuid
  productId            String?   @map("product_id") @db.Uuid
  medicineNameSnapshot String    @map("medicine_name_snapshot")
  quantity             Int
  unitPriceSnapshot    Decimal   @map("unit_price_snapshot") @db.Decimal(12, 2)
  /// quantity * unitPriceSnapshot. Was GENERATED; now set by the order service.
  lineTotal            Decimal   @default(0) @map("line_total") @db.Decimal(14, 2)
  batchNumber          String?   @map("batch_number")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ── renewals & follow-ups ────────────────────────────────────────────────────────────────

model Renewal {
  id                String    @id @default(uuid()) @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  customerName      String    @map("customer_name")
  orderId           String?   @map("order_id") @db.Uuid
  productId         String?   @map("product_id") @db.Uuid
  medicineName      String    @map("medicine_name")
  orderDate         DateTime  @map("order_date")
  renewalDate       DateTime  @map("renewal_date")
  expiryDate        DateTime  @map("expiry_date")
  assignedCallerId  String?   @map("assigned_caller_id") @db.Uuid
  previousRenewalId String?   @map("previous_renewal_id") @db.Uuid
  renewedAt         DateTime? @map("renewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by") @db.Uuid

  customer       Customer   @relation(fields: [customerId], references: [id])
  order          Order?     @relation(fields: [orderId], references: [id])
  product        Product?   @relation(fields: [productId], references: [id])
  assignedCaller User?      @relation("RenewalAssignedCaller", fields: [assignedCallerId], references: [id])
  followUps      FollowUp[]

  @@index([assignedCallerId, deletedAt])
  @@index([expiryDate])
  @@index([customerId])
  @@map("renewals")
}

model FollowUp {
  id               String    @id @default(uuid()) @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  customerName     String    @map("customer_name")
  leadId           String?   @map("lead_id") @db.Uuid
  renewalId        String?   @map("renewal_id") @db.Uuid
  assignedCallerId String?   @map("assigned_caller_id") @db.Uuid
  scheduledAt      DateTime  @map("scheduled_at")
  type             String    @default("call")
  status           String    @default("pending")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by") @db.Uuid

  customer       Customer?      @relation(fields: [customerId], references: [id])
  lead           Lead?          @relation(fields: [leadId], references: [id])
  renewal        Renewal?       @relation(fields: [renewalId], references: [id])
  assignedCaller User?          @relation("FollowUpAssignedCaller", fields: [assignedCallerId], references: [id])
  followUpType   FollowUpType   @relation(fields: [type], references: [code])
  followUpStatus FollowUpStatus @relation(fields: [status], references: [code])

  @@index([assignedCallerId, deletedAt])
  @@index([scheduledAt])
  @@index([leadId])
  @@index([renewalId])
  @@map("follow_ups")
}

// ── notifications & audit ────────────────────────────────────────────────────────────────

/// Previously partitioned by month; now a plain table.
model Notification {
  id                String                  @id @default(uuid()) @db.Uuid
  recipientUserId   String                  @map("recipient_user_id") @db.Uuid
  title             String
  message           String
  type              NotificationType        @default(info)
  isRead            Boolean                 @default(false) @map("is_read")
  readAt            DateTime?               @map("read_at")
  relatedEntityType NotificationEntityType? @map("related_entity_type")
  relatedEntityId   String?                 @map("related_entity_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at")

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, isRead])
  @@map("notifications")
}

/// Written by the audit service on every mutation. Previously a SECURITY DEFINER trigger
/// wrote this and the application could not touch it; now the application owns it, so the
/// trail is only as trustworthy as the application itself.
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tableName  String      @map("table_name")
  recordId   String      @map("record_id") @db.Uuid
  action     AuditAction
  changedBy  String?     @map("changed_by") @db.Uuid
  changedAt  DateTime    @default(now()) @map("changed_at")
  oldData    Json?       @map("old_data")
  newData    Json?       @map("new_data")

  @@index([tableName, recordId, changedAt])
  @@index([changedBy])
  @@map("audit_log")
}
