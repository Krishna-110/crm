{
  "name": "medcrm-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "setup": "tsx scripts/dev-setup.ts",
    "reset:test-data": "tsx scripts/reset-test-data.ts",
    "test:db": "tsx scripts/build-test-db.ts",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
