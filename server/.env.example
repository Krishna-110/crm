PGHOST=localhost
PGPORT=5432
PGDATABASE=medcrm

# Maintenance connection (schema owner). Used only by scheduler.ts and scripts/ for the
# work Prisma cannot do: REFRESH MATERIALIZED VIEW CONCURRENTLY and partition creation.
MAINT_PGHOST=localhost
MAINT_PGPORT=5432
MAINT_PGDATABASE=medcrm
MAINT_PGUSER=postgres
MAINT_PGPASSWORD=root

PORT=3001
TOKEN_TTL_HOURS=24

# Prisma data layer — the application connection. app_prisma has BYPASSRLS
# (db/migrations/016_prisma_role.sql); row filtering happens in application code via
# server/src/scope.ts, applied through the client extension in server/src/scopedPrisma.ts.
# RLS itself was disabled in db/migrations/017_disable_rls.sql.
DATABASE_URL=postgresql://app_prisma:prismatest123@localhost:5432/medcrm?schema=public

# PGUSER/PGPASSWORD are intentionally absent: they described app_user, the pre-Prisma
# application login, whose LOGIN was revoked in 017_disable_rls.sql.
